# Microsoft 365 / Azure AD OAuth (for live mailbox sync)
# Register an app at https://portal.azure.com → App registrations
AZURE_CLIENT_ID=
AZURE_TENANT_ID=common
AZURE_CLIENT_SECRET=
MAILBOX_EMAIL=

# Gmail OAuth (for live Gmail sync)
# Register at https://console.cloud.google.com/apis/credentials
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# LLM provider
# OpenAI, Anthropic, or Azure OpenAI endpoint
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_ENDPOINT=https://api.openai.com/v1

# Temporary SPINOR service boundary until session-backed organization membership exists.
# Send this value as Authorization: Bearer <token> or x-spinor-token.
# Production also requires a comma-separated organization allowlist.
SPINOR_API_TOKEN=
SPINOR_ALLOWED_ORGANIZATIONS=

# SPINOR append-only evidence store.
# The remote service must implement POST /events and GET /events?organizationId=...
# and return durable append receipts containing eventId, receiptHash, and storedAt.
SPINOR_STORE_URL=
SPINOR_STORE_TOKEN=

# Development-only local provider. Production fails closed without SPINOR_STORE_URL
# unless SPINOR_ALLOW_LOCAL_STORE=true is explicitly set for an ephemeral environment.
SPINOR_LOCAL_DATA_DIR=.spinor-data
SPINOR_ALLOW_LOCAL_STORE=false

# Public URL of the deployed app
# Used for OAuth redirect URI normalization
NEXT_PUBLIC_OAUTH_REDIRECT_BASE=https://your-project.vercel.app

# Non-local demo mode: when true, auto-loads sample data and disables sync
NEXT_PUBLIC_DEMO=true
