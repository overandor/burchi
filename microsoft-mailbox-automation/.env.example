# Microsoft 365 / Azure AD OAuth (for live mailbox sync)
# Register an app at https://portal.azure.com → App registrations
# Device-code and browser redirect flows are public-client OAuth and do not
# need a client secret. See README for the required API permissions.
AZURE_AD_CLIENT_ID=
AZURE_AD_TENANT_ID=common
MAILBOX_EMAIL=

# Gmail OAuth (for live Gmail sync)
# Register at https://console.cloud.google.com/apis/credentials
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# LLM provider — defaults to Prism Ollama on Fly.dev (free, no API key)
# Override with OpenAI/Anthropic/Azure by setting LLM_PROVIDER and OPENAI_API_KEY
OPENAI_API_KEY=
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:1b
LLM_ENDPOINT=https://prism-ollama.fly.dev/api/generate

# Foundry password auth
# FOUNDRY_SETUP_TOKEN is required to register users after the first account exists.
FOUNDRY_SETUP_TOKEN=change-me-in-production

# Public URL of the deployed app (for OAuth redirect URIs)
# HF Spaces:  https://luguog-mailbox-automation.hf.space
# Netlify:    https://your-site.netlify.app
# Vercel:     https://your-project.vercel.app
NEXT_PUBLIC_OAUTH_REDIRECT_BASE=https://luguog-over.hf.space

# Non-local demo mode: when true, auto-loads sample data and disables sync
NEXT_PUBLIC_DEMO=true
