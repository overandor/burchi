# Netlify redirects for Next.js route groups.
# The @netlify/plugin-nextjs handles API routes and dynamic routes.
# These redirects ensure that static pages from route groups (e.g. (app)/)
# are served correctly when the plugin's automatic routing misses them.
/today       /today.html       200
/foundry     /foundry.html     200
/experiment  /experiment.html  200
/history     /history.html     200
/spinor-rl   /spinor-rl.html   200
/golden-nodes /golden-nodes.html 200
/discovery-ledger /discovery-ledger.html 200
/learnings   /learnings.html   200
/process-lab /process-lab.html 200
/results     /results.html     200
/inbox       /inbox.html       200
/experiments /experiments.html 200
/spinor      /spinor.html      200
/spin-lifecycle /spin-lifecycle.html 200
/etl         /etl.html         200

# API routes and static assets must be served before the catch-all SPA rewrite.
/api/*       /api/:splat        200
/_next/*     /_next/:splat      200

# Catch-all for any client-routed path that does not match a generated HTML file.
/*           /index.html        200
